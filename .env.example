# Prefer node scripts/dev/init-env.mjs postgres https://guard.example.com to generate secrets.
SSHGUARD_IMAGE_TAG=v0.3.19
DB_DRIVER=postgres
COMPOSE_FILE=compose.yaml:deploy/compose/compose.postgres.yaml
COMPOSE_PATH_SEPARATOR=:
DATABASE_URL=postgres://sshguard:REPLACE_DB_PASSWORD@db:5432/sshguard?sslmode=disable
DB_PASSWORD=REPLACE_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
PUBLIC_URL=https://guard.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Exact private SMTP/webhook hostnames, comma-separated; leave empty for public destinations only.
NOTIFICATION_ALLOWED_HOSTS=
# Only these exact proxies may supply client IP forwarding headers. Empty uses loopback only.
TRUSTED_PROXY_CIDRS=
