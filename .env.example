# Prefer node scripts/init-env.mjs postgres https://guard.example.com to generate secrets.
DB_DRIVER=postgres
COMPOSE_FILE=compose.yaml:compose.postgres.yaml
COMPOSE_PATH_SEPARATOR=:
DATABASE_URL=postgres://sshguard:REPLACE_DB_PASSWORD@db:5432/sshguard?sslmode=disable
DB_PASSWORD=REPLACE_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
PUBLIC_URL=https://guard.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
