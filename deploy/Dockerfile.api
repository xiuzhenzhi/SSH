FROM golang:1.26.10-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X sshguard/internal/api.Version=$(cat VERSION)" -o /api ./cmd/api
FROM alpine:3.23
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 sshguard
COPY --from=build /api /usr/local/bin/sshguard-api
USER 10001
EXPOSE 8080
ENTRYPOINT ["sshguard-api"]
