FROM golang:1.26.10-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X sshguard/internal/api.Version=$(cat VERSION) -X sshguard/internal/api.AgentVersion=$(cat AGENT_VERSION)" -o /api ./cmd/api
FROM alpine:3.23
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 sshguard && mkdir -p /var/lib/sshguard && chown sshguard:sshguard /var/lib/sshguard && chmod 0700 /var/lib/sshguard
COPY --from=build /api /usr/local/bin/sshguard-api
USER 10001
EXPOSE 8080
ENTRYPOINT ["sshguard-api"]
