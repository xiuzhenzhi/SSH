FROM golang:1.26.10-alpine AS agent
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/agent ./cmd/agent
COPY VERSION ./VERSION
RUN mkdir /downloads && for os in linux windows; do for arch in amd64 arm64; do suffix=""; if [ "$os" = windows ]; then suffix=".exe"; fi; name="sshguard-agent-$os-$arch$suffix"; CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -ldflags="-s -w -X main.version=$(cat VERSION)" -o "/downloads/$name" ./cmd/agent || exit 1; (cd /downloads && sha256sum "$name" > "$name.sha256") || exit 1; done; done
FROM node:24-alpine AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web ./
RUN npm run build
FROM nginx:1.28-alpine
COPY --from=web /web/dist /usr/share/nginx/html
COPY --from=agent /downloads /usr/share/nginx/html/downloads
COPY scripts/install-agent.sh /usr/share/nginx/html/downloads/install-agent.sh
COPY scripts/install-agent.ps1 scripts/uninstall-agent.sh scripts/uninstall-agent.ps1 /usr/share/nginx/html/downloads/
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
