FROM node:24-alpine AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web ./
RUN npm run build
FROM nginx:1.28-alpine
COPY --from=web /web/dist /usr/share/nginx/html
COPY scripts/install-agent.sh /usr/share/nginx/html/downloads/install-agent.sh
COPY scripts/install-agent.ps1 scripts/uninstall-agent.sh scripts/uninstall-agent.ps1 /usr/share/nginx/html/downloads/
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
