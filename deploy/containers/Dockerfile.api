FROM --platform=$BUILDPLATFORM alpine:3.23 AS runtime
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 sshguard && mkdir -p /var/lib/sshguard && chown sshguard:sshguard /var/lib/sshguard && chmod 0700 /var/lib/sshguard
FROM alpine:3.23
ARG TARGETARCH
COPY --from=runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=runtime /etc/passwd /etc/group /etc/
COPY --from=runtime --chown=10001:10001 /var/lib/sshguard /var/lib/sshguard
COPY --chmod=0755 sshguard-linux-${TARGETARCH}/sshguard-api /usr/local/bin/sshguard-api
USER 10001
EXPOSE 8080
ENTRYPOINT ["sshguard-api"]
