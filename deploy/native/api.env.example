# Install as /etc/sshguard/api.env (root-owned, chmod 600).
DB_DRIVER=postgres
DATABASE_URL=postgres://sshguard:REPLACE_DB_PASSWORD@127.0.0.1:5432/sshguard?sslmode=disable
# MySQL alternative (parseTime=true is required, server timezone UTC):
# DB_DRIVER=mysql
# DATABASE_URL=sshguard:REPLACE_DB_PASSWORD@tcp(127.0.0.1:3306)/sshguard?parseTime=true&loc=UTC&charset=utf8mb4
# SQLite: create /var/lib/sshguard-api owned by sshguard-api with mode 0700.
# DB_DRIVER=sqlite
# DATABASE_URL=file:/var/lib/sshguard-api/sshguard.db
PUBLIC_URL=https://guard.example.com
LISTEN_ADDR=127.0.0.1:8080
# Web assets are detected in web/ next to the executable; optional explicit path:
# WEB_DIR=/opt/sshguard/web
# Direct HTTPS without Nginx/OpenResty (certificate files must be readable by service user):
# LISTEN_ADDR=0.0.0.0:8080
# PUBLIC_URL=https://guard.example.com:8080
# TLS_CERT_FILE=/etc/sshguard/tls/fullchain.pem
# TLS_KEY_FILE=/etc/sshguard/tls/privkey.pem
# Direct HTTP requires explicit opt-in; use HTTPS before enrolling Agents:
# PUBLIC_URL=http://192.168.1.10:8080
# ALLOW_INSECURE_HTTP=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_12_TO_72_BYTES
GIN_MODE=release
# Generate once with openssl rand -hex 32. Back up with the database; never rotate by overwriting.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
NOTIFICATION_ALLOWED_HOSTS=
