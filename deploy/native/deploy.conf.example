# Raw KEY=value, no shell quotes or expansion. chmod 600 before --config.
# DOMAIN=guard.example.com  # Only needed for explicit HTTPS/proxy mode.
# standalone: built-in web/API on APP_PORT; no Nginx required.
# external: existing Nginx/OpenResty/panel/proxy; no installation, reload or TLS changes.
# managed: script manages the system Nginx site and HTTPS (fresh servers).
PROXY_MODE=standalone
APP_PORT=8080
# sqlite uses /var/lib/sshguard-api/sshguard.db (omit DATABASE_URL).
# local-postgres installs PostgreSQL; mysql/postgres connect an existing database.
DB_DRIVER=sqlite
# DATABASE_URL=sshguard:REPLACE_PASSWORD@tcp(127.0.0.1:3306)/sshguard?charset=utf8mb4&parseTime=true&loc=UTC
# standalone: optional cert/key enable built-in HTTPS; omit both for HTTP.
# managed: configure cert/key or ACME_EMAIL. external: existing proxy handles TLS.
# TLS_CERT=/path/to/fullchain.pem
# TLS_KEY=/path/to/privkey.pem
# ACME_EMAIL=admin@example.com
# Empty/omitted ADMIN_PASSWORD generates a random password in /etc/sshguard/api.env.
