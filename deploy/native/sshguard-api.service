[Unit]
Description=SSHGuard API
After=network-online.target
Wants=network-online.target

[Service]
User=sshguard-api
Group=sshguard-api
WorkingDirectory=/opt/SSHGuard/Server
EnvironmentFile=/etc/sshguard/api.env
ExecStart=/opt/SSHGuard/Server/sshguard-api
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
StateDirectory=sshguard-api
StateDirectoryMode=0700
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
