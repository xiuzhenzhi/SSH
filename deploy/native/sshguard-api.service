[Unit]
Description=SSHGuard API
After=network-online.target
Wants=network-online.target

[Service]
User=sshguard-api
Group=sshguard-api
WorkingDirectory=/opt/SSHGuard/Server
EnvironmentFile=/opt/SSHGuard/Server/api.env
ExecStart=/opt/SSHGuard/Server/sshguard-api
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/SSHGuard/Server/data
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
